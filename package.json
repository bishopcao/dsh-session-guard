{
  "name": "dsh-session-guard",
  "version": "1.0.7",
  "description": "防止 DSH 删除父话题时连带删掉子会话；保留增量本地备份，可安全删除与恢复会话。",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.2",
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./core": "./core.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "core.js",
    "records.js",
    "backup.js",
    "delete.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "bishopcao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bishopcao/dsh-session-guard.git"
  },
  "bugs": {
    "url": "https://github.com/bishopcao/dsh-session-guard/issues"
  },
  "homepage": "https://github.com/bishopcao/dsh-session-guard#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "session",
    "archive",
    "backup",
    "restore",
    "cascade-delete",
    "会话守护",
    "会话备份",
    "误删恢复",
    "会话管理"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}